# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                        ZERAVYNEX CONFIGURATION                              ║
# ║            Copy this file to .env and configure for your environment         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Zeravynex
APP_ENV=development              # development | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1                        # Set to (2 * CPU_CORES + 1) in production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev - no setup required)
DATABASE_URL=sqlite:///./zeravynex.db

# PostgreSQL (production - uncomment and configure)
# DATABASE_URL=postgresql://zeravynex:your_secure_password@localhost:5432/zeravynex

# Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ── Redis Cache & Message Broker ─────────────────────────────────────────────
# Leave empty for in-memory LRU cache fallback (standalone mode)
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400          # 24 hours

# ── Celery Distributed Task Queue ────────────────────────────────────────────
USE_CELERY=false                 # Set to true to enable async analysis workers
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Storage Backend ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local            # local | s3
SAMPLES_DIR=./samples

# S3 / MinIO Settings (when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=zeravynex-samples
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=.exe,.dll,.sys

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_UPLOADS_PER_MIN=10

# ── YARA Rules ───────────────────────────────────────────────────────────────
YARA_RULES_DIR=./yara_rules

# ── ML Model ─────────────────────────────────────────────────────────────────
ML_MODEL_PATH=./ml/models/rf_malware_model.joblib

# ── AI Analyst (Optional LLM Integration) ────────────────────────────────────
# LLM_PROVIDER=openai             # openai | gemini | ollama
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...
# OLLAMA_BASE_URL=http://localhost:11434

