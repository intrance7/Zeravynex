# Zeravynex Configuration
# Copy this file to .env and fill in the values

# === Application ===
APP_NAME=Zeravynex
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# === File Upload ===
MAX_UPLOAD_SIZE_MB=100
SAMPLES_DIR=./samples
ALLOWED_EXTENSIONS=.exe,.dll

# === Database ===
DATABASE_URL=postgresql+asyncpg://zeravynex:zeravynex@localhost:5432/zeravynex

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === YARA ===
YARA_RULES_DIR=./yara_rules

# === ML Model ===
ML_MODEL_PATH=./ml/models/malware_classifier.joblib

# === AI Analyst (Stage 4) ===
# LLM_PROVIDER=openai  # openai | gemini | ollama
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# === Rate Limiting ===
RATE_LIMIT_UPLOADS_PER_MIN=10

# === CORS ===
CORS_ORIGINS=http://localhost:5173
